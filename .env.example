# HeadHunter API
# Optional: uncomment to override the configured HeadHunter User-Agent.
# HH_USER_AGENT=
# Optional: OAuth token; required only when require_authentication is enabled in preferences.yaml.
HH_ACCESS_TOKEN=

# Read-only IMAP email ingestion
# Optional: IMAP host; the application uses its built-in default when empty.
EMAIL_IMAP_HOST=
# Optional: IMAP port; the application uses its built-in default when empty.
EMAIL_IMAP_PORT=
# Required when email ingestion is enabled: mailbox account identifier.
EMAIL_IMAP_USER=
# Required when email ingestion is enabled: IMAP application password.
EMAIL_IMAP_APP_PASSWORD=
# Optional: mailbox/label name; the application uses its built-in default when empty.
EMAIL_IMAP_MAILBOX=

# Disabled legacy Jooble connector
# Required only if the current disabled Jooble source is explicitly re-enabled.
JOOBLE_API_KEY=
