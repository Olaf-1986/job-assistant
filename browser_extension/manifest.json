{
  "manifest_version": 3,
  "name": "Job Assistant Capture",
  "version": "0.1.0",
  "description": "Save the current vacancy page to the local Job Assistant.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Save to Job Assistant",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
