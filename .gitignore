# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/
pytest-of-*/
*:OECustomProperty

# Virtual environments
.venv
.env

# Generated job-assistant outputs
output/*
!output/.gitkeep

# User-provided vacancy text imports
input/manual/*
!input/manual/.gitkeep

# Browser auth state and local browser profiles
playwright/.auth/*
!playwright/.auth/.gitkeep
data/browser_profiles/*
!data/browser_profiles/.gitkeep
data/browser_profiles/linkedin/
data/capture_token
data/wellfound_failures/

# Telegram authentication and session artifacts
.session*
*.session*
*.auth_key
*.authkey
data/telegram_sessions/
data/telegram_auth/

# Windows Mark-of-the-Web metadata
*:Zone.Identifier
